+		 * in hw_var_set_opmode() when leaving monitor. (airscope beacon-RX fix) */
+		pHalData->rxfltmap0_backup = rtw_read16(Adapter, REG_RXFLTMAP0);
+		rtw_write16(Adapter, REG_RXFLTMAP0, 0xFFFF);
